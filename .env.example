# DeepFlow environment variables
#
# Leave VITE_API_URL empty (or unset) to run in MOCK mode — the app uses the
# bundled mock SSE stream and demo data. This is the default for local previews.
#
# Set VITE_API_URL to a backend origin (e.g. http://localhost:8000) to connect
# the live agent pipeline to a real SSE endpoint at
#   ${VITE_API_URL}/api/{persona}/stream?session_id={sessionId}
VITE_API_URL=
